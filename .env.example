# Firebase web app (safe to expose in the browser; these are not secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Firebase Auth UID of the one account allowed to use the app.
# Must exactly match the UID in firestore.rules.
OWNER_UID=

# Base64-encoded Firebase service account JSON. Server-only.
# macOS: base64 -i service-account.json | tr -d '\n'
# Linux: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Fixed token for the /api/mcp connector. Server-only.
# Prefer sending it as: Authorization: Bearer <token>
# Clients without a header field can use: /api/mcp?key=<token>
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional. Extra browser origins accepted by the MCP Origin check.
# Allowlisted browser origins also receive CORS headers; server-to-server
# Anthropic requests have no Origin and normally do not need this.
# Example for the ext-apps basic-host: http://localhost:8080
MCP_ALLOWED_ORIGINS=
