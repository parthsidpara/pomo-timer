# Firebase web app (safe to expose in the browser; these are not secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Firebase Auth UID of the one account allowed to use the app.
# Must exactly match the UID in firestore.rules.
OWNER_UID=

# Base64-encoded Firebase service account JSON. Server-only.
# macOS: base64 -i service-account.json | tr -d '\n'
# Linux: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Fixed bearer token for the /api/mcp connector. Server-only.
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional. Extra origins accepted by the MCP Origin validation check.
# CORS is not enabled; Anthropic's cloud connector does not send an Origin
# header and normally does not need this. Example: https://your-preview.vercel.app
MCP_ALLOWED_ORIGINS=
